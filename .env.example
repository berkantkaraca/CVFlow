# Copy to .env and fill in real values. Never commit .env.
GEMINI_API_KEY=your-gemini-api-key-here
# Required for login tokens in production (min 32 characters, random).
# Development default is built into application.yml — override it for any shared environment.
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
# Optional: override when running outside Docker Compose (default http://localhost:3000)
PDF_GOTENBERG_URL=http://localhost:3000
